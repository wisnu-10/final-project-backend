// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// customer & AUTHENTICATION
// ==========================================

model Customer {
  id              String         @id @default(uuid()) @db.Uuid
  firstName       String?        @map("first_name")
  lastName        String?        @map("last_name")
  email           String         @unique
  phoneNumber     String?        @map("phone_number")
  password        String?
  role            Role           @default(customer)
  profilePicture  String?        @map("profile_picture")
  isVerified      Boolean        @default(false) @map("is_verified")
  
  oauthAccounts   OauthAccount[]
  tokens          Token[]
  addresses       customerAddress[]
  orders          Order[]
  complaints      Complaint[]

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  @@map("customers")
}

model Employee {
  id                 String         @id @default(uuid()) @db.Uuid
  outletId           String?         @db.Uuid @map("outlet_id")
  firstName          String         @map("first_name")
  lastName           String         @map("last_name")
  email              String         @unique
  phoneNumber        String         @map("phone_number")
  password           String
  role               Role
  profilePicture     String?        @map("profile_picture")
  identityNumber     String         @unique @map("identity_number")
  bankAccountNumber  String         @map("bank_account_number")

  outlet             Outlet?         @relation(fields: [outletId], references: [id])
  attendances        Attendance[]
  ordersAdmin        Order[]        @relation("AdminOrders")
  ordersPickup       Order[]        @relation("DriverPickupOrders")
  ordersDelivery     Order[]        @relation("DriverDeliveryOrders")
  statusLogs         OrderStatus[]
  bypassRequested    BypassRequest[] @relation("RequestedBy")
  bypassApproved     BypassRequest[] @relation("ApprovedBy")

  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  @@map("employees")
}

enum Role {
  customer
  super_admin
  outlet_admin
  worker
  driver
}

model OauthAccount {
  id                String       @id @default(uuid())
  customerId        String       @map("customer_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")

  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  TWITTER
}

model Token {
  id            String    @id @default(uuid())
  customerId    String    @map("customer_id") @db.Uuid
  token         String    @unique
  type          TokenType
  expiresAt     DateTime  @map("expires_at")
  isUsed        Boolean   @default(false) @map("is_used")

  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("tokens")
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ==========================================
// LOCATION & OUTLET
// ==========================================

model customerAddress {
  id                       String    @id @default(uuid()) @db.Uuid
  customerId               String    @map("customer_id") @db.Uuid
  recipientName            String    @map("recipient_name")
  recipientPhoneNumber     String    @map("recipient_phone_number")
  label                    String
  address                  String    @db.Text
  districtId               Int       @map("district_id")
  districtName             String    @map("district_name")
  cityId                   Int       @map("city_id")
  cityName                 String    @map("city_name")
  provinceId               Int       @map("province_id")
  provinceName             String    @map("province_name")
  postalCode               String    @map("postal_code")
  notes                    String?   @db.Text
  latitude                 Float
  longitude                Float
  isPrimary                Boolean   @default(false) @map("is_primary")

  customer                 Customer  @relation(fields: [customerId], references: [id])
  ordersPickup             Order[]   @relation("PickupAddress")
  ordersDelivery           Order[]   @relation("DeliveryAddress")

  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  @@map("customer_addresses")
}

model Outlet {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String
  address             String     @db.Text
  districtId          Int        @map("district_id")
  districtName        String     @map("district_name")
  cityId              Int        @map("city_id")
  cityName            String     @map("city_name")
  provinceId          Int        @map("province_id")
  provinceName        String     @map("province_name")
  postalCode          String     @map("postal_code")
  latitude            Float
  longitude           Float
  maxServiceDistance  Float      @map("max_service_distance")
  isActive            Boolean    @map("is_active")

  employees           Employee[]
  orders              Order[]

  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  @@map("outlets")
}

// ==========================================
// HR & ATTENDANCE
// ==========================================

model Shift {
  id          String       @id @default(uuid()) @db.Uuid
  shiftName   String       @map("shift_name")
  startTime   DateTime     @map("start_time")
  endTime     DateTime     @map("end_time")
  
  attendances Attendance[]

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  @@map("shifts")
}

model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  employeeId String           @map("employee_id") @db.Uuid
  shiftId    String           @map("shift_id") @db.Uuid
  checkIn    DateTime         @map("check_in")
  checkOut   DateTime?        @map("check_out")
  date       DateTime         @db.Date
  status     AttendanceStatus
  notes      String?          @db.Text

  employee   Employee         @relation(fields: [employeeId], references: [id])
  shift      Shift            @relation(fields: [shiftId], references: [id])

  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  deletedAt  DateTime?        @map("deleted_at")

  @@map("attendances")
}

enum AttendanceStatus {
  present
  late
  absent
}

// ==========================================
// ORDER FLOW
// ==========================================

model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  outletId            String        @db.Uuid @map("outlet_id")
  customerId          String        @db.Uuid @map("customer_id")
  adminId             String?       @db.Uuid @map("admin_id")
  driverPickupId      String?       @db.Uuid @map("driver_pickup_id")
  driverDeliveryId    String?       @db.Uuid @map("driver_delivery_id")
  pickupAddressId     String        @db.Uuid @map("pickup_address_id")
  deliveryAddressId   String        @db.Uuid @map("delivery_address_id")

  scheduleTime        DateTime      @map("schedule_time")
  distancePickup      Float         @map("distance_pickup")
  distanceDelivery    Float         @map("distance_delivery")
  startedPickupAt     DateTime?     @map("started_pickup_at")
  completedPickupAt   DateTime?     @map("completed_pickup_at")
  startedDeliveryAt   DateTime?     @map("started_delivery_at")
  completedDeliveryAt DateTime?     @map("completed_delivery_at")

  pricePerKg          Decimal       @map("price_per_kg")
  totalWeight         Decimal?      @map("total_weight")
  totalPrice          Decimal?      @map("total_price")

  outlet              Outlet        @relation(fields: [outletId], references: [id])
  customer            Customer      @relation(fields: [customerId], references: [id])
  admin               Employee?     @relation("AdminOrders", fields: [adminId], references: [id])
  driverPickup        Employee?     @relation("DriverPickupOrders", fields: [driverPickupId], references: [id])
  driverDelivery      Employee?     @relation("DriverDeliveryOrders", fields: [driverDeliveryId], references: [id])
  pickupAddress       customerAddress   @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  deliveryAddress     customerAddress   @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])

  statusLogs          OrderStatus[]
  orderItems          OrderItem[]
  payments            Payment[]
  complaints          Complaint[]
  bypassRequests      BypassRequest[]

  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  @@map("orders")
}

model OrderStatus {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @map("order_id") @db.Uuid
  workerId   String?     @map("worker_id") @db.Uuid
  totalItem  Int?        @map("total_item")
  startedAt  DateTime?   @map("started_at")
  finishedAt DateTime?   @map("finished_at")
  status     OrderStatusEnum

  order      Order       @relation(fields: [orderId], references: [id])
  worker     Employee?   @relation(fields: [workerId], references: [id])

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  deletedAt  DateTime?   @map("deleted_at")

  @@map("order_statuses")
}

enum OrderStatusEnum {
  waiting_pickup
  on_the_way_to_outlet
  arrived_outlet
  washing
  ironing
  packing
  waiting_payment
  ready_delivery
  delivering
  completed
}

model OrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  laundryItemId  String       @map("laundry_item_id") @db.Uuid
  quantity       Int
  subTotal       Decimal?

  order          Order        @relation(fields: [orderId], references: [id])
  laundryItem    LaundryItem  @relation(fields: [laundryItemId], references: [id])

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  @@map("order_items")
}

model LaundryItem {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  pricingType PricingType @default(kiloan) @map("pricing_type")
  price       Decimal     @default(0) @db.Decimal(10, 2)

  orderItems  OrderItem[]

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  @@map("laundry_items")
}

enum PricingType {
  kiloan
  per_item
}

// ==========================================
// PAYMENTS & SUPPORT
// ==========================================

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  
  amount                Decimal?
  method                PaymentMethod?
  gatewayTransactionId  String?         @map("gateway_transaction_id")
  paymentUrl            String?         @map("payment_url")
  status                PaymentStatus   @default(pending)
  paidAt                DateTime?       @map("paid_at")

  reminderSentCount     Int             @default(0)
  lastReminderSentAt    DateTime?       @map("last_reminder_sent_at")

  order                 Order         @relation(fields: [orderId], references: [id])

  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  @@map("payments")
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
}

enum PaymentMethod {
  qris
  bank_transfer
  ewallet
}

model BypassRequest {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  requestedBy      String       @map("requested_by") @db.Uuid
  approvedBy       String       @map("approved_by") @db.Uuid
  approvedAt       DateTime?    @map("approved_at")
  notes            String       @db.Text
  status           BypassStatus
  expectedQuantity Int          @map("expected_quantity")
  actualQuantity   Int          @map("actual_quantity")

  order            Order        @relation(fields: [orderId], references: [id])
  requester        Employee     @relation("RequestedBy", fields: [requestedBy], references: [id])
  approver         Employee     @relation("ApprovedBy", fields: [approvedBy], references: [id])

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  @@map("bypass_requests")
}

enum BypassStatus {
  waiting
  approved
  rejected
}

model Complaint {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  customerId  String          @map("customer_id") @db.Uuid
  description String          @db.Text
  status      ComplaintStatus

  order       Order           @relation(fields: [orderId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  @@map("complaints")
}

enum ComplaintStatus {
  pending
  resolved
  rejected
}